# Optional: meta-tag verification (alternative to HTML files in public/)
# Google Search Console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → Verify ownership → Meta tag (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 → Admin → Data streams → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=
